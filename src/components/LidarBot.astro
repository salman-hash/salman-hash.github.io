---
// Hero animation: a 2D differential-drive robot doing reactive LiDAR obstacle
// avoidance. The pointer is an extra (moving) obstacle. Vanilla canvas, no deps.
---

<figure class="panel relative overflow-hidden" aria-labelledby="lidar-caption">
  <div class="flex items-center justify-between border-b border-line px-3 py-2 font-mono text-[0.7rem] text-muted">
    <span><span aria-hidden="true" class="text-accent-ink">●</span> sim://lidar_avoid</span>
    <span id="lidar-hud" aria-hidden="true">/cmd_vel v=0.00 ω=0.00</span>
  </div>
  <div class="relative h-64 sm:h-80 lg:h-[22rem]">
    <canvas id="lidar-canvas" class="absolute inset-0 size-full touch-pan-y" aria-hidden="true"></canvas>
  </div>
  <figcaption id="lidar-caption" class="sr-only">
    Decorative animation: a small simulated robot sweeps LiDAR rays and steers around obstacles, including your
    mouse cursor.
  </figcaption>
  <p class="pointer-events-none absolute bottom-2 left-3 font-mono text-[0.65rem] text-muted" aria-hidden="true">
    move your cursor into its path
  </p>
</figure>

<script>
  type Obstacle = { x: number; y: number; r: number };
  type Hit = { x: number; y: number; t: number };

  const canvas = document.getElementById('lidar-canvas') as HTMLCanvasElement | null;
  const hud = document.getElementById('lidar-hud');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const RAYS = 37;
    const FOV = Math.PI * 1.1; // ~200°
    const RANGE = 130;
    const BOT_R = 9;
    const TRAIL_MS = 1600;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    let w = 0;
    let h = 0;
    let obstacles: Obstacle[] = [];
    let hits: Hit[] = [];
    const bot = { x: 0, y: 0, th: 0, v: 0, w: 0 };
    let cursor: Obstacle | null = null;
    let colors = { accent: '#f5a524', fg: '#e7e9ec', muted: '#9ba5b0', line: '#262d36' };
    let running = false;
    let visible = true;
    let raf = 0;
    let last = 0;
    let frame = 0;
    let lastScan: number[] = [];
    let lastNow = 0;

    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      const v = (n: string, fb: string) => s.getPropertyValue(n).trim() || fb;
      colors = { accent: v('--accent', colors.accent), fg: v('--fg', colors.fg), muted: v('--muted', colors.muted), line: v('--line', colors.line) };
    };

    // Seeded RNG so the layout is stable between resizes of the same size.
    const rng = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

    const layout = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const rand = rng(Math.round(w) * 31 + Math.round(h));
      const count = Math.max(5, Math.round((w * h) / 16000));
      obstacles = [];
      for (let tries = 0; obstacles.length < count && tries < 400; tries++) {
        const r = 10 + rand() * 18;
        const o = { x: r + rand() * (w - 2 * r), y: r + rand() * (h - 2 * r), r };
        const clearOfCenter = Math.hypot(o.x - w / 2, o.y - h / 2) > r + 50;
        const clearOfOthers = obstacles.every((p) => Math.hypot(p.x - o.x, p.y - o.y) > p.r + o.r + 28);
        if (clearOfCenter && clearOfOthers) obstacles.push(o);
      }
      bot.x = w / 2;
      bot.y = h / 2;
      hits = [];
    };

    // Distance along a ray to the nearest obstacle or wall (capped at RANGE).
    const cast = (ox: number, oy: number, a: number, obs: Obstacle[]) => {
      const dx = Math.cos(a);
      const dy = Math.sin(a);
      let best = RANGE;
      for (const o of obs) {
        const fx = ox - o.x;
        const fy = oy - o.y;
        const b = fx * dx + fy * dy;
        const c = fx * fx + fy * fy - o.r * o.r;
        const disc = b * b - c;
        if (disc < 0) continue;
        const t = -b - Math.sqrt(disc);
        if (t > 0 && t < best) best = t;
      }
      if (dx > 0) best = Math.min(best, (w - ox) / dx);
      if (dx < 0) best = Math.min(best, -ox / dx);
      if (dy > 0) best = Math.min(best, (h - oy) / dy);
      if (dy < 0) best = Math.min(best, -oy / dy);
      return Math.max(0, best);
    };

    const step = (dt: number, now: number) => {
      const obs = cursor ? [...obstacles, cursor] : obstacles;
      const scan: number[] = [];
      let turn = 0;
      let front = RANGE;
      for (let i = 0; i < RAYS; i++) {
        const rel = -FOV / 2 + (i / (RAYS - 1)) * FOV;
        const d = cast(bot.x, bot.y, bot.th + rel, obs);
        scan.push(d);
        // Closer hits push harder; obstacles to the left (rel<0) steer right.
        const k = 1 - d / RANGE;
        turn -= Math.sign(rel || 1e-6) * k * k * (1.2 - Math.abs(rel) / FOV);
        if (Math.abs(rel) < 0.35) front = Math.min(front, d);
        if (d < RANGE && i % 2 === frame % 2) {
          hits.push({ x: bot.x + Math.cos(bot.th + rel) * d, y: bot.y + Math.sin(bot.th + rel) * d, t: now });
        }
      }
      // Wander a little so the path stays interesting in open space.
      const wander = Math.sin(now / 1300) * 0.25;
      const targetW = Math.max(-3, Math.min(3, turn * 2.4 + wander));
      const targetV = 22 + 48 * Math.min(1, Math.max(0, (front - BOT_R * 2) / (RANGE * 0.6)));
      bot.w += (targetW - bot.w) * Math.min(1, dt * 6);
      bot.v += (targetV - bot.v) * Math.min(1, dt * 4);
      bot.th += bot.w * dt;
      bot.x = Math.min(w - BOT_R, Math.max(BOT_R, bot.x + Math.cos(bot.th) * bot.v * dt));
      bot.y = Math.min(h - BOT_R, Math.max(BOT_R, bot.y + Math.sin(bot.th) * bot.v * dt));

      // Escape if wedged inside/against something (e.g. cursor dropped on top).
      for (const o of obs) {
        const dd = Math.hypot(bot.x - o.x, bot.y - o.y);
        if (dd < o.r + BOT_R) {
          const a = Math.atan2(bot.y - o.y, bot.x - o.x);
          bot.x = o.x + Math.cos(a) * (o.r + BOT_R);
          bot.y = o.y + Math.sin(a) * (o.r + BOT_R);
        }
      }
      hits = hits.filter((p) => now - p.t < TRAIL_MS);
      return scan;
    };

    const draw = (scan: number[], now: number) => {
      lastScan = scan;
      lastNow = now;
      ctx.clearRect(0, 0, w, h);

      // Rays
      ctx.strokeStyle = colors.accent;
      ctx.globalAlpha = 0.16;
      ctx.lineWidth = 1;
      ctx.beginPath();
      scan.forEach((d, i) => {
        const a = bot.th - FOV / 2 + (i / (RAYS - 1)) * FOV;
        ctx.moveTo(bot.x, bot.y);
        ctx.lineTo(bot.x + Math.cos(a) * d, bot.y + Math.sin(a) * d);
      });
      ctx.stroke();

      // Fading point cloud
      ctx.fillStyle = colors.accent;
      for (const p of hits) {
        ctx.globalAlpha = 0.9 * (1 - (now - p.t) / TRAIL_MS);
        ctx.fillRect(p.x - 1.25, p.y - 1.25, 2.5, 2.5);
      }
      ctx.globalAlpha = 1;

      // Obstacles (faint; the robot "sees" them through the scan)
      ctx.strokeStyle = colors.muted;
      ctx.globalAlpha = 0.35;
      for (const o of obstacles) {
        ctx.beginPath();
        ctx.arc(o.x, o.y, o.r, 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      if (cursor) {
        ctx.strokeStyle = colors.accent;
        ctx.setLineDash([3, 4]);
        ctx.beginPath();
        ctx.arc(cursor.x, cursor.y, cursor.r, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // Robot body + heading
      ctx.save();
      ctx.translate(bot.x, bot.y);
      ctx.rotate(bot.th);
      ctx.fillStyle = colors.line;
      ctx.strokeStyle = colors.fg;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.roundRect(-BOT_R, -BOT_R * 0.8, BOT_R * 2, BOT_R * 1.6, 3);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = colors.accent;
      ctx.beginPath();
      ctx.arc(BOT_R * 0.35, 0, 2.6, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      if (hud && frame % 8 === 0) {
        hud.textContent = `/cmd_vel v=${(bot.v / 100).toFixed(2)} ω=${bot.w.toFixed(2)}`;
      }
    };

    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
      last = now;
      frame++;
      draw(step(dt, now), now);
      raf = requestAnimationFrame(tick);
    };

    const start = () => {
      if (running || reduced.matches || !visible || document.hidden) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    // Reduced motion: settle the sim off-screen, then paint one still frame.
    const still = () => {
      let scan: number[] = [];
      for (let i = 0; i < 90; i++) scan = step(1 / 30, i * 33);
      draw(scan, 90 * 33);
    };

    const reset = () => {
      stop();
      readColors();
      layout();
      if (reduced.matches) still();
      else start();
    };

    const pointer = (e: PointerEvent) => {
      if (reduced.matches) return;
      const r = canvas.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      cursor = x >= 0 && y >= 0 && x <= r.width && y <= r.height ? { x, y, r: 20 } : null;
    };

    new ResizeObserver(reset).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? start() : stop();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduced.addEventListener('change', reset);
    new MutationObserver(() => {
      readColors();
      if (!running) draw(lastScan, lastNow);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    canvas.parentElement!.addEventListener('pointermove', pointer, { passive: true });
    canvas.parentElement!.addEventListener('pointerleave', () => (cursor = null));
  }
</script>
