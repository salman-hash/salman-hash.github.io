---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { formatMonth } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Eager-load the cover (use for above-the-fold cards). */
  eager?: boolean;
  /** Title heading level — h2 when cards sit directly under the page h1. */
  headingLevel?: 'h2' | 'h3';
}

const { project, eager = false, headingLevel: Heading = 'h3' } = Astro.props;
const { title, summary, tags, cover, coverAlt, date, org } = project.data;
---

<article
  class="panel relative flex h-full flex-col overflow-hidden transition-colors hover:border-accent focus-within:border-accent"
>
  <Image
    src={cover}
    alt={coverAlt}
    widths={[400, 640, 800]}
    sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
    loading={eager ? 'eager' : 'lazy'}
    class="aspect-[16/10] w-full border-b border-line object-cover"
  />
  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="label flex flex-wrap gap-x-3">
      <time datetime={date.toISOString()}>{formatMonth(date)}</time>
      {org && <span>{org}</span>}
    </p>
    <Heading class="text-lg font-semibold leading-snug tracking-tight">
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">
        {title}
      </a>
    </Heading>
    <p class="text-sm leading-relaxed text-muted">{summary}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-1" aria-label="Topics">
      {tags.map((t) => <li><Tag label={t} /></li>)}
    </ul>
  </div>
</article>
