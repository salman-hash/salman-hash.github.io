---
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';
import { cleanPath } from '../lib/content';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-center gap-2 font-mono text-sm font-semibold tracking-tight">
      <span class="inline-block size-2 rounded-full bg-accent" aria-hidden="true"></span>
      <span>{site.name.toLowerCase().replace(' ', '_')}</span>
    </a>
    <nav aria-label="Primary" class="order-3 w-full sm:order-none sm:w-auto sm:flex-1">
      <ul class="-mx-1.5 flex flex-wrap font-mono text-[0.8125rem] sm:-mx-2 sm:text-sm">
        {
          nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class="block px-1.5 py-1.5 text-muted sm:px-2 transition-colors hover:text-fg aria-[current=page]:text-accent-ink"
              >
                <span aria-hidden="true" class="opacity-50">/</span>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto sm:ml-0">
      <ThemeToggle />
    </div>
  </div>
</header>
