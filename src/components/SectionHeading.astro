---
interface Props {
  title: string;
  id?: string;
  level?: 'h1' | 'h2';
}
const { title, id, level: Tag = 'h2' } = Astro.props;
---

<div class="mb-8">
  <Tag id={id} class:list={['font-semibold tracking-tight', Tag === 'h1' ? 'text-3xl sm:text-4xl' : 'text-2xl']}>
    {title}
  </Tag>
  <slot />
</div>
