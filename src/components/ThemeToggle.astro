<button
  type="button"
  id="theme-toggle"
  class="btn px-2.5 py-2"
  aria-label="Switch to light theme"
>
  <svg class="theme-icon-sun size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="theme-icon-moon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-icon-moon {
    display: none;
  }
  :global([data-theme='light']) .theme-icon-sun {
    display: none;
  }
  :global([data-theme='light']) .theme-icon-moon {
    display: block;
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const sync = () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    btn.setAttribute('aria-label', `Switch to ${next} theme`);
  };
  sync();
  btn.addEventListener('click', () => {
    const theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    sync();
  });
</script>
