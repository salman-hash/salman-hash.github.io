---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';

const channels = [
  { label: 'email', value: site.email, href: `mailto:${site.email}` },
  { label: 'linkedin', value: 'in/salman-sadiq', href: site.socials.linkedin },
  { label: 'github', value: 'salman-hash', href: site.socials.github },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Salman Sadiq about working-student roles, thesis projects or robotics collaborations."
>
  <div class="max-w-3xl pt-12">
    <SectionHeading kicker="contact" title="Get in touch" level="h1">
      <p class="mt-3 text-lg text-muted">
        I'm based in {site.location.replace(', DE', ', Germany')} and currently <span class="text-fg">open to
        working-student and thesis roles</span> in robotics, perception and embedded systems. Email is the fastest way
        to reach me.
      </p>
    </SectionHeading>

    <ul class="panel divide-y divide-line">
      {
        channels.map((c) => (
          <li>
            <a
              href={c.href}
              rel={c.label === 'email' ? undefined : 'me noopener'}
              class="group flex flex-wrap items-center justify-between gap-2 p-4 transition-colors hover:bg-surface-2 sm:p-5"
            >
              <span class="label w-24">{c.label}</span>
              <span class="flex-1 font-mono text-sm break-all group-hover:text-accent-ink sm:text-base">{c.value}</span>
              <span aria-hidden="true" class="text-muted group-hover:text-accent-ink">↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 font-mono text-sm text-muted">
      Prefer paper? <a class="link" href={site.cv} download>download my cv</a>.
    </p>
  </div>
</BaseLayout>
