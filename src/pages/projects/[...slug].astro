---
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { formatMonth, getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { title, summary, role, org, date, tags, stack, cover, coverAlt, links } = project.data;
const { Content } = await render(project);
const og = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'png' });

const linkLabels: Record<string, string> = { repo: 'Source code', demo: 'Live demo', paper: 'Read the paper', video: 'Watch the video' };
const linkList = Object.entries(links).filter(([, url]) => url) as [string, string][];
---

<BaseLayout title={title} description={summary} image={og.src} imageAlt={coverAlt} type="article">
  <article class="pt-10">
    <nav aria-label="Breadcrumb" class="text-sm font-medium text-muted">
      <a href="/projects" class="hover:text-fg"><span aria-hidden="true">← </span>All projects</a>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="label flex flex-wrap gap-x-3">
        <time datetime={date.toISOString()}>{formatMonth(date)}</time>
        {org && <span>{org}</span>}
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{summary}</p>
      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Topics">
        {tags.map((t) => <li><Tag label={t} /></li>)}
      </ul>
    </header>

    <Image
      src={cover}
      alt={coverAlt}
      widths={[640, 960, 1200]}
      sizes="(min-width: 1152px) 1104px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="panel mt-8 aspect-[16/9] w-full object-cover"
    />

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_17rem]">
      <div class="prose-mc max-w-none min-w-0">
        <Content />
      </div>

      <aside class="space-y-6 lg:order-none" aria-label="Project details">
        <dl class="panel space-y-5 p-5 text-sm">
          <div>
            <dt class="label">Role</dt>
            <dd class="mt-1">{role}</dd>
          </div>
          {
            stack.length > 0 && (
              <div>
                <dt class="label">Tech stack</dt>
                <dd class="mt-2">
                  <ul class="flex flex-wrap gap-1.5">
                    {stack.map((s) => (
                      <li class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs font-medium">{s}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          {
            linkList.length > 0 && (
              <div>
                <dt class="label">Links</dt>
                <dd class="mt-1">
                  <ul class="space-y-1 text-sm">
                    {linkList.map(([k, url]) => (
                      <li>
                        <a class="link" href={url} rel="noopener">
                          {linkLabels[k] ?? k} <span aria-hidden="true">↗</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
    </div>

    {
      next.id !== project.id && (
        <nav aria-label="Next project" class="mt-16 border-t border-line pt-6">
          <a href={`/projects/${next.id}`} class="group block">
            <span class="label">Next project</span>
            <span class="mt-1 block text-xl font-semibold group-hover:text-accent-ink">
              {next.data.title} <span aria-hidden="true">→</span>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>
