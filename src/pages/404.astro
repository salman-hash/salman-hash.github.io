---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <div class="max-w-2xl pt-20">
    <p class="text-sm font-semibold text-accent-ink">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-4 text-lg text-muted">The page you're looking for may have moved or no longer exists.</p>
    <a href="/" class="btn btn-primary mt-8">Back to home</a>
  </div>
</BaseLayout>
